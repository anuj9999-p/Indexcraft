# All optional; defaults are shown. The API never accepts file paths from clients.
INDEXCRAFT_DATA_DIR=./data                 # directory holding indexcraft.db
INDEXCRAFT_BUILD_DIR=./build               # where libindexcraft.so / indexcraft_bench live (build/engine)
INDEXCRAFT_MAX_KEYS=64                     # B+ Tree node capacity used when the API opens the file
INDEXCRAFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INDEXCRAFT_MAX_BENCH_SIZE=1000000          # largest dataset a benchmark job may request
INDEXCRAFT_MAX_PAYLOAD_BYTES=65536         # API-level payload limit (engine limit is 1 MiB)
INDEXCRAFT_FRONTEND_DIST=./frontend/dist   # served at / when it exists
